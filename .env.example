# ---------------------------------------------------------------------------
# Testimonials — environment configuration
# Copy this file to `.env.local` locally, fill in the values, and set the same
# variables in Vercel (Project Settings → Environment Variables).
# Local and production share the SAME TESTIMONIALS_DSN so both talk to Neon.
# ---------------------------------------------------------------------------

# Neon PostgreSQL connection string (production + local).
# Use the pooler connection string (host looks like <project>.<region>.pooler.aws.neon.tech)
# for serverless. TLS is enabled automatically for *.neon.tech hosts by the
# PostgresStore, so a plain postgres:// URL works too.
#
# Example:
# TESTIMONIALS_DSN=postgresql://neondb_owner:password@ep-abc-123.us-east-2.aws.neon.tech/neondb?sslmode=require
#
# The standard DATABASE_URL (e.g. pulled by `neon link`) is also accepted.
# DATABASE_URL=postgresql://neondb_owner:password@ep-abc-123-pooler.aws.neon.tech/neondb?sslmode=require

# Secret token required to approve/reject/delete testimonials.
# Must match on local and production for moderate via curl.
TESTIMONIALS_ADMIN_TOKEN=change-me-to-a-long-random-string

# Optional webhook. On each submission a payload (with token-signed approve/reject
# links) is POSTed here; if unset, the payload is logged to the server console.
# TESTIMONIALS_NOTIFY_URL=https://example.com/hooks/testimonials